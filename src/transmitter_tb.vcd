	Mon Oct 26 10:48:22 2026
$end
$version
	ModelSim Version 2020.1
$end
$timescale
	1ps
$end

$scope module transmitter_tb $end
$var parameter 32 ! CLK_FREQ $end
$var parameter 32 " BAUD_RATE $end
$var parameter 32 # CLK_PERIOD $end
$var parameter 32 $ DIV $end
$var parameter 32 % BIT_TIME $end
$var parameter 32 & DEPTH $end
$var reg 1 ' clk $end
$var reg 1 ( rst $end
$var reg 8 ) tx_data_in [7:0] $end
$var reg 1 * we $end
$var reg 1 + tx $end
$var reg 1 , tx_active $end
$var reg 1 - full_tx $end
$var reg 1 . empty_tx $end
$var integer 32 / rx_count $end
$var integer 32 0 errors $end
$var reg 1 1 mon_ignore $end

$scope task write_byte $end
$upscope $end

$scope task write_burst $end
$upscope $end

$scope task drain $end
$upscope $end

$scope task check_state $end
$upscope $end

$scope begin monitor $end
$var reg 8 2 b [7:0] $end
$var reg 8 3 e [7:0] $end
$upscope $end

$scope module dut $end
$var parameter 32 4 clk_freq $end
$var parameter 32 5 baud_rate $end
$var reg 1 6 clk $end
$var reg 1 7 rst $end
$var reg 8 8 tx_data_in [7:0] $end
$var reg 1 9 we $end
$var reg 1 : tx $end
$var reg 1 ; tx_active $end
$var reg 1 < full_tx $end
$var reg 1 = empty_tx $end
$var reg 8 > ff_out [7:0] $end
$var reg 1 ? start $end
$var reg 1 @ tx_busy $end
$var reg 1 A done_tx $end

$scope module ftx $end
$var reg 1 B clk $end
$var reg 1 C rst $end
$var reg 8 D ff_in [7:0] $end
$var reg 1 E we $end
$var reg 1 F re $end
$var reg 8 G ff_out [7:0] $end
$var reg 1 H full $end
$var reg 1 I empty $end
$var reg 5 J wr_ptr [4:0] $end
$var reg 5 K rd_ptr [4:0] $end
$upscope $end

$scope module utx $end
$var parameter 32 L clk_freq $end
$var parameter 32 M baud_rate $end
$var parameter 32 N clock_divide $end
$var wire 1 O clk $end
$var wire 1 P rst $end
$var wire 1 Q start $end
$var wire 1 R tx_data_in [7] $end
$var wire 1 S tx_data_in [6] $end
$var wire 1 T tx_data_in [5] $end
$var wire 1 U tx_data_in [4] $end
$var wire 1 V tx_data_in [3] $end
$var wire 1 W tx_data_in [2] $end
$var wire 1 X tx_data_in [1] $end
$var wire 1 Y tx_data_in [0] $end
$var wire 1 Z tx $end
$var wire 1 [ tx_active $end
$var reg 1 \ done_tx $end
$var wire 1 ] tx_busy $end
$var reg 3 ^ tx_STATE [2:0] $end
$var reg 3 _ tx_NEXT [2:0] $end
$var reg 10 ` clk_div_reg [9:0] $end
$var reg 10 a clk_div_next [9:0] $end
$var reg 8 b tx_data_reg [7:0] $end
$var reg 8 c tx_data_next [7:0] $end
$var reg 1 d tx_out_reg $end
$var reg 1 e tx_out_next $end
$var reg 3 f index_bit_reg [2:0] $end
$var reg 3 g index_bit_next [2:0] $end
$upscope $end
$upscope $end
$upscope $end
$enddefinitions $end
