$scope module receiver_tb $end
$var parameter 32 ! CLK_FREQ $end
$var parameter 32 " BAUD_RATE $end
$var parameter 32 # CLK_PERIOD $end
$var parameter 32 $ DIV $end
$var parameter 32 % BIT_TIME $end
$var parameter 32 & DEPTH $end
$var reg 1 ' clk $end
$var reg 1 ( rst $end
$var reg 1 ) rx $end
$var reg 1 * re $end
$var reg 8 + rx_data_out [7:0] $end
$var reg 1 , full_rx $end
$var reg 1 - empty_rx $end
$var integer 32 . errors $end

$scope function pattern $end
$upscope $end

$scope task send_frame $end
$upscope $end

$scope task settle $end
$upscope $end

$scope task check_flags $end
$upscope $end

$scope task pop_check $end
$upscope $end

$scope module dut $end
$var parameter 32 / clk_freq $end
$var parameter 32 0 baud_rate $end
$var reg 1 1 clk $end
$var reg 1 2 rst $end
$var reg 1 3 rx $end
$var reg 1 4 re $end
$var reg 8 5 rx_data_out [7:0] $end
$var reg 1 6 full_rx $end
$var reg 1 7 empty_rx $end
$var reg 8 8 data [7:0] $end
$var reg 1 9 done $end
$var reg 1 : we_wire $end
$var reg 1 ; re_wire $end
$var reg 1 < empty_wire $end
$var reg 1 = full_wire $end

$scope module urx $end
$var parameter 32 > clk_freq $end
$var parameter 32 ? baud_rate $end
$var parameter 32 @ clock_divide $end
$var parameter 32 A CNT_W $end
$var reg 1 B clk $end
$var reg 1 C rst $end
$var reg 1 D rx $end
$var reg 8 E rx_data_out [7:0] $end
$var reg 1 F rx_done $end
$var reg 3 G rx_STATE [2:0] $end
$var reg 3 H rx_NEXT [2:0] $end
$var reg 4 I clk_div_reg [3:0] $end
$var reg 4 J clk_div_next [3:0] $end
$var reg 8 K rx_data_reg [7:0] $end
$var reg 8 L rx_data_next [7:0] $end
$var reg 3 M index_bit_reg [2:0] $end
$var reg 3 N index_bit_next [2:0] $end
$var reg 1 O rx_ff1 $end
$var reg 1 P rx_sync $end
$upscope $end

$scope module frx $end
$var reg 1 Q clk $end
$var reg 1 R rst $end
$var reg 8 S ff_in [7:0] $end
$var reg 1 T we $end
$var reg 1 U re $end
$var reg 8 V ff_out [7:0] $end
$var reg 1 W full $end
$var reg 1 X empty $end
$var reg 5 Y wr_ptr [4:0] $end
$var reg 5 Z rd_ptr [4:0] $end
$upscope $end
$upscope $end
$upscope $end
